# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# CareLink Clinical AI Portal – Environment Configuration
# Copy this file to .env (or .env.local) and fill in your values
# NEVER commit .env to git
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ■■ 1. Supabase (Required for Auth + Database) ■■
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ■■ 2. Primary LLM: Google Gemini 2.5 Flash ■■
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ■■ 3. Secondary Failover LLM: Groq Cloud (<500ms auto-failover on rate limits) ■■
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_ROUTING_MODEL=openai/gpt-oss-20b

# ■■ 4. Vector Knowledge Base: Qdrant Cloud (Clinical RAG Engine) ■■
# Get cluster URL & API key at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# ■■ 5. Long-Term Patient Memory: Mem0 Cloud ■■
# Get your key at: https://app.mem0.ai/
MEM0_API_KEY=your-mem0-api-key-here
MEM0_DIR=.runtime/mem0

# ■■ 6. Agent Observability: LangSmith (Optional) ■■
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=carelink-bharat-agentic-2026

# ■■ 7. Application & ML API URLs ■■
VITE_APP_NAME=CareLink
VITE_APP_URL=http://localhost:3005
VITE_ML_API_URL=http://localhost:8001

# ■■ 8. LiveKit Closed-Loop Telephony & SIP Outbound ■■
# Get credentials at: https://cloud.livekit.io/
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_TRUNK_ID=your-stored-sip-trunk-id
LIVEKIT_VOICE_AGENT_NAME=carelink-escalation-agent

# Telephony Policy (mock | live)
TELEPHONY_MODE=mock
TELEPHONY_PRIMARY_CONTACT=+919876543210
TELEPHONY_SECONDARY_CONTACT=+919876543211
TELEPHONY_MAX_ATTEMPTS=2
TELEPHONY_COOLDOWN_SEC=300
TELEPHONY_RING_TIMEOUT_SEC=30

# ■■ 9. Sarvam AI: Indic Multi-Language Speech & Translation ■■
# Get your API key at: https://www.sarvam.ai/
SARVAM_API_KEY=your-sarvam-api-key-here

# ■■ 10. Digital India Bhashini (MeitY National Language Translation Mission) ■■
# Get your credentials at: https://bhashini.gov.in/ulca/ / https://meity.gov.in/
BHASHINI_USER_ID=your-bhashini-user-id-here
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_INFERENCE_API_KEY=your-bhashini-inference-api-key-here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d0

# Indic Provider Routing Preference: auto | bhashini | sarvam
INDIC_DEFAULT_PROVIDER=auto

